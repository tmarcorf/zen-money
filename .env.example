# ============================================================
# ZenMoney Docker Compose — Environment Variables
# Copy this file to .env and fill in your production values
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ZenMoneyDB
DB_PORT=5432

# ---- JWT Authentication ----
# IMPORTANT: Change this to a strong random key in production!
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=dev-secret-change-me-in-production-min-32-chars!!
JWT_ISSUER=https://tmarcorf-tech.vercel.app
JWT_AUDIENCE=https://tmarcorf-tech.vercel.app

# ---- API ----
API_PORT=7109

# ---- CORS ----
# Comma-separated list of allowed origins (browser URLs)
CORS_ORIGINS=http://localhost:8080

# ---- Frontend ----
FRONTEND_PORT=8080
# The URL the browser uses to reach the API (baked into the JS at build time)
VITE_API_URL=http://localhost:7109
